<Window x:Class="MarketPOS.Arayuzler.GirisEkraniWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="SüperMarket POS v2.0 - Kullanıcı Girişi" Height="500" Width="450"
        WindowStartupLocation="CenterScreen" ResizeMode="NoResize" Background="#2C3E50"
        WindowStyle="None" AllowsTransparency="True" Loaded="Window_Loaded">

    <Border CornerRadius="12" Background="#F4F6F9" Margin="10">
        <Border.Effect>
            <DropShadowEffect BlurRadius="15" ShadowDepth="3" Opacity="0.3"/>
        </Border.Effect>
        
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Kapat Butonu -->
            <Button Grid.Row="0" Content="✕" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="10" 
                    Background="Transparent" BorderThickness="0" FontSize="18" FontWeight="Bold" Foreground="#7F8C8D" Click="BtnKapat_Click"/>

            <!-- Logo ve Başlık -->
            <StackPanel Grid.Row="0" Margin="0,30,0,10">
                <TextBlock Text="🛒" FontSize="60" HorizontalAlignment="Center" Margin="0,0,0,10"/>
                <TextBlock Text="SüperMarket POS v2.0" FontSize="22" FontWeight="Black" Foreground="#2C3E50" HorizontalAlignment="Center"/>
                <TextBlock Text="Kullanıcı Girişi" FontSize="16" Foreground="#7F8C8D" HorizontalAlignment="Center" Margin="0,5,0,0"/>
            </StackPanel>

            <!-- Giriş Formu -->
            <StackPanel Grid.Row="1" Margin="40,20,40,0">
                <TextBlock Text="Kullanıcı Adı" FontWeight="Bold" Foreground="#34495E" Margin="0,0,0,5"/>
                <TextBox x:Name="txtKullaniciAdi" FontSize="18" Padding="12" Margin="0,0,0,15" BorderBrush="#BDC3C7" BorderThickness="2">
                    <TextBox.Resources><Style TargetType="{x:Type Border}"><Setter Property="CornerRadius" Value="6"/></Style></TextBox.Resources>
                </TextBox>

                <TextBlock Text="Şifre" FontWeight="Bold" Foreground="#34495E" Margin="0,0,0,5"/>
                <PasswordBox x:Name="txtSifre" FontSize="18" Padding="12" Margin="0,0,0,25" BorderBrush="#BDC3C7" BorderThickness="2" KeyDown="TxtSifre_KeyDown">
                    <PasswordBox.Resources><Style TargetType="{x:Type Border}"><Setter Property="CornerRadius" Value="6"/></Style></PasswordBox.Resources>
                </PasswordBox>

                <!-- Hata Mesajı Alanı -->
                <TextBlock x:Name="txtHataMesaji" Text="" Foreground="#E74C3C" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,0,0,10" Visibility="Collapsed"/>

                <Button Content="GİRİŞ YAP" Background="#3498DB" Foreground="White" FontSize="18" FontWeight="Black" Padding="0,15" BorderThickness="0" Click="BtnGiris_Click">
                    <Button.Resources><Style TargetType="{x:Type Border}"><Setter Property="CornerRadius" Value="8"/></Style></Button.Resources>
                    <Button.Effect>
                        <DropShadowEffect BlurRadius="10" ShadowDepth="2" Opacity="0.2" Color="#3498DB"/>
                    </Button.Effect>
                </Button>
            </StackPanel>

            <!-- Alt Bilgi -->
            <StackPanel Grid.Row="2" Margin="0,0,0,20">
                <TextBlock Text="MarketPOS Sistemleri © 2026" FontSize="12" Foreground="#95A5A6" HorizontalAlignment="Center"/>
            </StackPanel>
        </Grid>
    </Border>
</Window>
