<Window x:Class="MarketPOS.Arayuzler.BekleyenSatislarWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Beklemeye Alınan Satışlar" Height="550" Width="700"
        WindowStartupLocation="CenterScreen" ResizeMode="NoResize" Background="#F4F6F9"
        Loaded="Window_Loaded">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="50" />
            <RowDefinition Height="*" />
            <RowDefinition Height="50" />
        </Grid.RowDefinitions>

        <!-- Header -->
        <TextBlock Grid.Row="0" Text="⏸️ Beklemeye Alınan Satış Listesi" FontSize="20" FontWeight="Bold" Foreground="#2C3E50" HorizontalAlignment="Center" VerticalAlignment="Center" />

        <!-- Bekleyen Satış Kartları -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <ItemsControl x:Name="lstBekleyenler">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Background="White" CornerRadius="8" Padding="15" Margin="0,0,0,12" BorderBrush="#E67E22" BorderThickness="2">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <!-- Sol: Detaylar -->
                                <StackPanel Grid.Column="0">
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,5">
                                        <Border Background="#E67E22" CornerRadius="4" Padding="6,2" Margin="0,0,10,0">
                                            <TextBlock Text="{Binding SaatMetni}" Foreground="White" FontSize="13" FontWeight="Bold"/>
                                        </Border>
                                        <TextBlock Text="{Binding OzetBaslik}" FontSize="16" FontWeight="Bold" Foreground="#2C3E50"/>
                                    </StackPanel>

                                    <TextBlock Text="{Binding UrunDetayMetni}" FontSize="14" Foreground="#7F8C8D" TextWrapping="Wrap" Margin="0,3,0,5"/>

                                    <TextBlock Text="{Binding TutarMetni}" FontSize="18" FontWeight="Bold" Foreground="#27AE60"/>
                                </StackPanel>

                                <!-- Sağ: Butonlar -->
                                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                    <Button Content="⚡ Ekrana Yükle" Background="#2ECC71" Foreground="White" FontWeight="Bold" FontSize="14" Padding="12,8" Margin="0,0,8,0" BorderThickness="0" Tag="{Binding}" Click="BtnYukle_Click">
                                        <Button.Resources>
                                            <Style TargetType="{x:Type Border}">
                                                <Setter Property="CornerRadius" Value="6"/>
                                            </Style>
                                        </Button.Resources>
                                    </Button>

                                    <Button Content="🗑️ Sil" Background="#E74C3C" Foreground="White" FontWeight="Bold" FontSize="14" Padding="10,8" BorderThickness="0" Tag="{Binding}" Click="BtnSil_Click">
                                        <Button.Resources>
                                            <Style TargetType="{x:Type Border}">
                                                <Setter Property="CornerRadius" Value="6"/>
                                            </Style>
                                        </Button.Resources>
                                    </Button>
                                </StackPanel>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>

        <!-- Alt Kapat Butonu -->
        <Button Grid.Row="2" Content="Pencereyi Kapat (ESC)" Background="#7F8C8D" Foreground="White" FontSize="15" FontWeight="Bold" VerticalAlignment="Bottom" Padding="0,10" BorderThickness="0" Click="BtnKapat_Click" IsCancel="True">
            <Button.Resources>
                <Style TargetType="{x:Type Border}">
                    <Setter Property="CornerRadius" Value="6"/>
                </Style>
            </Button.Resources>
        </Button>
    </Grid>
</Window>
