<Window x:Class="MarketPOS.Arayuzler.SifreDegistirWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="🔑 Şifre Değiştir" Height="400" Width="420"
        WindowStartupLocation="CenterOwner" Background="#F4F6F9" FontFamily="Segoe UI" FontSize="15"
        ResizeMode="NoResize" Loaded="Window_Loaded">
    <StackPanel Margin="25">
        <TextBlock Text="🔑 ŞİFRE DEĞİŞTİR" FontSize="20" FontWeight="Bold" Foreground="#2C3E50" HorizontalAlignment="Center" Margin="0,0,0,5"/>
        <TextBlock x:Name="txtKullanici" FontSize="13" Foreground="#7F8C8D" HorizontalAlignment="Center" Margin="0,0,0,15"/>

        <TextBlock Text="Mevcut Şifre:" FontWeight="Bold" Foreground="#34495E"/>
        <PasswordBox x:Name="txtMevcut" Padding="6" Margin="0,3,0,10"/>

        <TextBlock Text="Yeni Şifre (en az 4 karakter):" FontWeight="Bold" Foreground="#34495E"/>
        <PasswordBox x:Name="txtYeni" Padding="6" Margin="0,3,0,10"/>

        <TextBlock Text="Yeni Şifre (Tekrar):" FontWeight="Bold" Foreground="#34495E"/>
        <PasswordBox x:Name="txtYeniTekrar" Padding="6" Margin="0,3,0,15"/>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="10"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Button Content="💾 Kaydet" Background="#27AE60" Foreground="White" FontWeight="Bold" Padding="0,10" BorderThickness="0" Click="BtnKaydet_Click" IsDefault="True"/>
            <Button Grid.Column="2" Content="Vazgeç" Background="#95A5A6" Foreground="White" FontWeight="Bold" Padding="0,10" BorderThickness="0" IsCancel="True"/>
        </Grid>
    </StackPanel>
</Window>
