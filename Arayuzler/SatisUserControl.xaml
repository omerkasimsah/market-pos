<UserControl x:Class="MarketPOS.Arayuzler.SatisUserControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             mc:Ignorable="d" 
             d:DesignHeight="600" d:DesignWidth="1024"
             Background="#F4F6F9" FontFamily="Segoe UI" FontSize="16"
             Loaded="UserControl_Loaded" Unloaded="UserControl_Unloaded">

    <!-- Resources for Buttons (Copied from MainWindow) -->
    <UserControl.Resources>
        <Style x:Key="NumpadButtonStyle" TargetType="Button">
            <Setter Property="FontSize" Value="28" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="Background" Value="White" />
            <Setter Property="Foreground" Value="#2C3E50" />
            <Setter Property="Margin" Value="3" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="BorderBrush" Value="#BDC3C7" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="8">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        
        <Style x:Key="HizliUrunButtonStyle" TargetType="Button">
            <Setter Property="FontSize" Value="18" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Background" Value="#3498DB" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="Margin" Value="3" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="8">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#2980B9" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="ShortcutButtonStyle" TargetType="Button">
            <Setter Property="FontSize" Value="18" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="Margin" Value="5" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="5">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="130" /> <!-- Üst Bilgi / Toplam Tutar -->
            <RowDefinition Height="*" />   <!-- Orta Alan -->
            <RowDefinition Height="80" />  <!-- Alt Menü / Kısayol Bilgileri -->
        </Grid.RowDefinitions>
        
        <!-- Toast Bildirimi (Gizli) -->
        <Border x:Name="brdToast" Grid.Row="0" Grid.RowSpan="2" HorizontalAlignment="Right" VerticalAlignment="Top" 
                Background="#2ECC71" CornerRadius="5" Padding="15,10" Margin="0,20,20,0" Visibility="Collapsed" Panel.ZIndex="100">
            <TextBlock x:Name="txtToastMesaj" Text="Bildirim Mesajı" Foreground="White" FontSize="16" FontWeight="Bold" />
        </Border>

        <Border Grid.Row="0" Background="#2C3E50" Padding="20,15">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                
                <!-- Barkod & Satış Sayısı Alanı -->
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Content="🏠 Ana Menü" Background="#1ABC9C" Foreground="White" FontWeight="Bold" FontSize="14" Padding="12,8" Margin="0,0,12,0" VerticalAlignment="Center" Click="BtnAnaMenu_Click">
                        <Button.Resources>
                            <Style TargetType="{x:Type Border}">
                                <Setter Property="CornerRadius" Value="6"/>
                            </Style>
                        </Button.Resources>
                    </Button>

                    <TextBlock Text="Barkod:" Foreground="#BDC3C7" FontSize="22" FontWeight="Bold" VerticalAlignment="Center" Margin="0,0,8,0" />
                    
                    <Border Background="White" CornerRadius="8" Padding="10,5" Width="220" Height="50" VerticalAlignment="Center" BorderBrush="#7F8C8D" BorderThickness="2">
                        <TextBox x:Name="txtGizliBarkod" FontSize="18" FontWeight="Bold" Background="Transparent" BorderThickness="0" IsReadOnly="True" Text="Barkod bekleniyor..." VerticalAlignment="Center" />
                    </Border>

                    <!-- Bugünkü Satış Sayısı Kartı -->
                    <Border Background="#34495E" CornerRadius="8" Padding="10,6" Margin="10,0,8,0" VerticalAlignment="Center">
                        <StackPanel Orientation="Vertical">
                            <TextBlock Text="BUGÜNKÜ SATIŞ" Foreground="#BDC3C7" FontSize="10" FontWeight="Bold"/>
                            <TextBlock x:Name="txtBugunkuSatisSayisi" Text="0 Adet" Foreground="#1ABC9C" FontSize="16" FontWeight="Bold"/>
                        </StackPanel>
                    </Border>

                    <!-- Aktif Kasiyer -->
                    <Border Background="#34495E" CornerRadius="8" Padding="10,6" Margin="0,0,8,0" VerticalAlignment="Center">
                        <StackPanel Orientation="Vertical">
                            <TextBlock Text="KASİYER" Foreground="#BDC3C7" FontSize="10" FontWeight="Bold"/>
                            <TextBlock x:Name="txtKasiyer" Text="-" Foreground="White" FontSize="14" FontWeight="Bold" MaxWidth="140" TextTrimming="CharacterEllipsis"/>
                        </StackPanel>
                    </Border>

                    <!-- Son Okutulan Ürün ve Kalan Stok -->
                    <Border Background="#1E2A38" CornerRadius="8" Padding="10,6" Margin="8,0,0,0" VerticalAlignment="Center">
                        <StackPanel Orientation="Vertical">
                            <TextBlock Text="SON ÜRÜN BİLGİSİ" Foreground="#7F8C8D" FontSize="10" FontWeight="Bold"/>
                            <TextBlock x:Name="txtSonUrunBilgisi" Text="--" Foreground="#F1C40F" FontSize="14" FontWeight="Bold" MaxWidth="250" TextTrimming="CharacterEllipsis"/>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- Genel Toplam Neon Kartı -->
                <Border Grid.Column="1" Background="#1E2A38" CornerRadius="12" Padding="20,10" BorderBrush="#00FF66" BorderThickness="2" MinWidth="350">
                    <StackPanel Orientation="Vertical" VerticalAlignment="Center" HorizontalAlignment="Right">
                        <TextBlock Text="GENEL TOPLAM" Foreground="#00FF66" FontSize="18" FontWeight="Bold" HorizontalAlignment="Right" />
                        <TextBlock x:Name="txtGenelToplam" Text="0,00 ₺" Foreground="#00FF66" FontSize="56" FontWeight="Black" HorizontalAlignment="Right" >
                            <TextBlock.Effect>
                                <DropShadowEffect Color="#00FF66" BlurRadius="20" ShadowDepth="0" Opacity="0.5" />
                            </TextBlock.Effect>
                        </TextBlock>
                        <TextBlock x:Name="txtIskonto" Text="Uygulanan İskonto: 0,00 ₺" Foreground="#E74C3C" FontSize="16" FontWeight="Bold" HorizontalAlignment="Right" Margin="0,5,0,0" Visibility="Collapsed" />
                        <TextBlock x:Name="txtSepetOzeti" Text="0 kalem" Foreground="#7F8C8D" FontSize="12" HorizontalAlignment="Right" />
                    </StackPanel>
                </Border>
            </Grid>
        </Border>

        <!-- 3. Ana Bölge: Sepet ve Numpad/Hızlı Ürünler -->
        <Grid Grid.Row="1" Margin="10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="6*" /> <!-- Sol: Sepet + 3 Slot -->
                <ColumnDefinition Width="4*" /> <!-- Sağ: Hızlı Ürünler + Numpad -->
            </Grid.ColumnDefinitions>

            <!-- Sol Kısım: Sepet DataGrid + 3-Slot Bekleyen Sepetler -->
            <Grid Grid.Column="0" Margin="0,0,10,0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <Border Grid.Row="0" Background="White" CornerRadius="8" BorderBrush="#E0E0E0" BorderThickness="1">
                    <DataGrid x:Name="dgSepet" AutoGenerateColumns="False" CanUserAddRows="False" CanUserDeleteRows="False" IsReadOnly="True" SelectionMode="Single"
                              HeadersVisibility="Column" GridLinesVisibility="Horizontal" HorizontalGridLinesBrush="#E0E0E0"
                              RowHeight="50" FontSize="18" Background="Transparent" BorderThickness="0" 
                              AlternatingRowBackground="#F2F4F4" RowBackground="White">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Ürün Adı" Binding="{Binding UrunAdi}" Width="*" IsReadOnly="True" />
                            <DataGridTextColumn Header="Miktar" Binding="{Binding Adet, StringFormat=0.###}" Width="90" IsReadOnly="True">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="HorizontalAlignment" Value="Center" />
                                        <Setter Property="VerticalAlignment" Value="Center" />
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                            <DataGridTextColumn Header="B. Fiyat" Binding="{Binding BirimFiyat, StringFormat={}{0:N2} ₺}" Width="130" IsReadOnly="True">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="HorizontalAlignment" Value="Right" />
                                        <Setter Property="VerticalAlignment" Value="Center" />
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                            <DataGridTextColumn Header="Toplam" Binding="{Binding ToplamFiyat, StringFormat={}{0:N2} ₺}" Width="140" IsReadOnly="True">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="HorizontalAlignment" Value="Right" />
                                        <Setter Property="VerticalAlignment" Value="Center" />
                                        <Setter Property="FontWeight" Value="Bold" />
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                </Border>

                <!-- Tekli Sepet Park Etme Sistemi (Eskisi Gibi) -->
                <Grid Grid.Row="1" Height="45" Margin="0,5,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="60" />
                        <ColumnDefinition Width="60" />
                        <ColumnDefinition Width="110" />
                    </Grid.ColumnDefinitions>
                    <Button Grid.Column="2" Content="＋" ToolTip="Seçili satırın adedini artır (Numpad +)" Background="#27AE60" Foreground="White" FontWeight="Bold" FontSize="22" Margin="5,0,0,0" BorderThickness="0" Click="BtnAdetArtir_Click" Focusable="False"/>
                    <Button Grid.Column="3" Content="－" ToolTip="Seçili satırın adedini azalt (Numpad -)" Background="#E67E22" Foreground="White" FontWeight="Bold" FontSize="22" Margin="5,0,0,0" BorderThickness="0" Click="BtnAdetAzalt_Click" Focusable="False"/>
                    <Button Grid.Column="4" Content="🗑 SATIR SİL" ToolTip="Seçili satırı sil (Delete)" Background="#C0392B" Foreground="White" FontWeight="Bold" FontSize="13" Margin="5,0,0,0" BorderThickness="0" Click="BtnSatirSil_Click" Focusable="False"/>

                    <Button x:Name="btnParkEt" Grid.Column="0" Content="SEPETİ PARK ET (BEKLET)" Background="#F39C12" Foreground="White" FontWeight="Bold" FontSize="14" Margin="0,0,5,0" BorderThickness="0" Click="BtnParkEt_Click">
                        <Button.Resources><Style TargetType="{x:Type Border}"><Setter Property="CornerRadius" Value="6"/></Style></Button.Resources>
                    </Button>
                    <Button x:Name="btnParktanCagir" Grid.Column="1" Content="PARKTAN ÇAĞIR" Background="#D35400" Foreground="White" FontWeight="Bold" FontSize="14" Margin="5,0,0,0" BorderThickness="0" Click="BtnParktanCagir_Click">
                        <Button.Resources><Style TargetType="{x:Type Border}"><Setter Property="CornerRadius" Value="6"/></Style></Button.Resources>
                    </Button>
                </Grid>
            </Grid>

            <!-- Sağ Kısım -->
            <Grid Grid.Column="1">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" /> <!-- Hızlı Ürünler -->
                    <RowDefinition Height="*" />    <!-- Numpad -->
                </Grid.RowDefinitions>
                
                <!-- Hızlı Ürün Butonları -->
                <StackPanel Grid.Row="0" Margin="0,0,0,10">
                    <TextBlock Text="Hızlı Ürünler / Kategoriler" FontWeight="Bold" FontSize="18" Margin="5,0,0,5" Foreground="#34495E"/>
                    <UniformGrid Columns="3" Rows="2" Height="140">
                        <Button Content="Ekmek" Style="{StaticResource HizliUrunButtonStyle}" Click="HizliUrun_Click" Tag="Ekmek" />
                        <Button Content="Su (5L)" Style="{StaticResource HizliUrunButtonStyle}" Click="HizliUrun_Click" Tag="Su (5L)" Background="#2980B9" />
                        <Button Content="Poşet" Style="{StaticResource HizliUrunButtonStyle}" Click="HizliUrun_Click" Tag="Poşet" Background="#8E44AD" />
                        <Button Content="Manav" Style="{StaticResource HizliUrunButtonStyle}" Click="HizliKategori_Click" Tag="Manav" Background="#27AE60" />
                        <Button Content="Şarküteri" Style="{StaticResource HizliUrunButtonStyle}" Click="HizliKategori_Click" Tag="Şarküteri" Background="#E67E22" />
                        <Button Content="Gazete" Style="{StaticResource HizliUrunButtonStyle}" Click="HizliUrun_Click" Tag="Gazete" Background="#7F8C8D" />
                    </UniformGrid>
                </StackPanel>

                <!-- Numpad -->
                <StackPanel Grid.Row="1" VerticalAlignment="Stretch">
                    <TextBlock Text="Numpad" FontWeight="Bold" FontSize="18" Margin="5,5,0,5" Foreground="#34495E"/>
                    <UniformGrid Columns="3" Rows="5" Height="330">
                        <Button Content="7" Style="{StaticResource NumpadButtonStyle}" Click="Numpad_Click"/>
                        <Button Content="8" Style="{StaticResource NumpadButtonStyle}" Click="Numpad_Click"/>
                        <Button Content="9" Style="{StaticResource NumpadButtonStyle}" Click="Numpad_Click"/>
                        
                        <Button Content="4" Style="{StaticResource NumpadButtonStyle}" Click="Numpad_Click"/>
                        <Button Content="5" Style="{StaticResource NumpadButtonStyle}" Click="Numpad_Click"/>
                        <Button Content="6" Style="{StaticResource NumpadButtonStyle}" Click="Numpad_Click"/>
                        
                        <Button Content="1" Style="{StaticResource NumpadButtonStyle}" Click="Numpad_Click"/>
                        <Button Content="2" Style="{StaticResource NumpadButtonStyle}" Click="Numpad_Click"/>
                        <Button Content="3" Style="{StaticResource NumpadButtonStyle}" Click="Numpad_Click"/>
                        
                        <Button Content="C" Background="#E74C3C" Foreground="White" FontSize="24" FontWeight="Bold" Margin="3" Click="NumpadTemizle_Click">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border Background="{TemplateBinding Background}" CornerRadius="8">
                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>
                        <Button Content="0" Style="{StaticResource NumpadButtonStyle}" Click="Numpad_Click"/>
                        <Button Content="X (Adet)" Background="#F39C12" Foreground="White" FontSize="20" FontWeight="Bold" Margin="3" Click="AdetCarp_Click" Focusable="False">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border Background="{TemplateBinding Background}" CornerRadius="8">
                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>

                        <Button Content="," Style="{StaticResource NumpadButtonStyle}" Click="Numpad_Click" Focusable="False"/>
                        <Button Content="⌫" Style="{StaticResource NumpadButtonStyle}" Click="NumpadSil_Click" Focusable="False"/>
                        <Button Content="GİR ↵" Background="#2980B9" Foreground="White" FontSize="20" FontWeight="Bold" Margin="3" Click="NumpadEnter_Click" Focusable="False" ToolTip="Yazılan barkodu/ürün kodunu sepete ekle">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border Background="{TemplateBinding Background}" CornerRadius="8">
                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>
                    </UniformGrid>
                </StackPanel>
            </Grid>
        </Grid>

        <!-- 4. Alt Kısım: Kısayollar -->
        <Border Grid.Row="2" Background="#ECF0F1" BorderBrush="#BDC3C7" BorderThickness="0,1,0,0">
            <UniformGrid Columns="12" Margin="5" TextElement.FontSize="14">
                <Button Content="F1: Nakit" Background="#2ECC71" Style="{StaticResource ShortcutButtonStyle}" FontSize="15" Click="BtnNakit_Click" Focusable="False" />
                <Button Content="F2: Kart" Background="#3498DB" Style="{StaticResource ShortcutButtonStyle}" FontSize="15" Click="BtnKrediKarti_Click" Focusable="False" />
                <Button Content="F3: Veresiye" Background="#9B59B6" Style="{StaticResource ShortcutButtonStyle}" FontSize="15" Click="BtnVeresiye_Click" Focusable="False" />
                <Button Content="F4: İptal" Background="#E74C3C" Style="{StaticResource ShortcutButtonStyle}" FontSize="15" Click="BtnIptal_Click" Focusable="False" />
                <Button Content="F5: İskonto" Background="#F1C40F" Foreground="Black" Style="{StaticResource ShortcutButtonStyle}" FontSize="15" Click="BtnIskonto_Click" Focusable="False" />
                <Button Content="F6: P.Üstü" Background="#1ABC9C" Style="{StaticResource ShortcutButtonStyle}" FontSize="15" Click="BtnParaUstu_Click" Focusable="False" />
                <Button Content="F7: Beklet" Background="#E67E22" Style="{StaticResource ShortcutButtonStyle}" FontSize="15" Click="BtnParkEt_Click" Focusable="False" />
                <Button Content="F8: Böl" Background="#34495E" Style="{StaticResource ShortcutButtonStyle}" FontSize="15" Click="BtnBolunmusOdeme_Click" Focusable="False" />
                <Button Content="F9: Fiyat" Background="#16A085" Style="{StaticResource ShortcutButtonStyle}" FontSize="15" Click="BtnFiyatGor_Click" Focusable="False" />
                <Button Content="F10: İade" Background="#C0392B" Style="{StaticResource ShortcutButtonStyle}" FontSize="15" Click="BtnIade_Click" Focusable="False" />
                <Button Content="F11: Son Fiş" Background="#7F8C8D" Style="{StaticResource ShortcutButtonStyle}" FontSize="15" Click="BtnSonFis_Click" Focusable="False" />
                <Button Content="F12: Ürün Ara" Background="#2980B9" Style="{StaticResource ShortcutButtonStyle}" FontSize="15" Click="BtnUrunAra_Click" Focusable="False" />
            </UniformGrid>
        </Border>
    </Grid>
</UserControl>
