<Window x:Class="MarketPOS.Arayuzler.ToptanciFaturaWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Toptancı İrsaliye &amp; Fatura Girişi" Height="700" Width="1000"
        WindowStartupLocation="CenterScreen" Background="#F4F6F9"
        Loaded="Window_Loaded">

    <Grid Margin="15">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Üst Başlık -->
        <Border Grid.Row="0" Background="#D35400" CornerRadius="8" Padding="15" Margin="0,0,0,10">
            <StackPanel Orientation="Vertical">
                <TextBlock Text="🚚 TOPTANCI FATURA / İRSALİYE GİRİŞİ" FontSize="22" FontWeight="Black" Foreground="White"/>
                <TextBlock Text="Toplu mal alımı ve stok güncelleme ekranı" FontSize="14" Foreground="#FAD7A1" Margin="0,3,0,0"/>
            </StackPanel>
        </Border>

        <!-- Fatura Üst Bilgileri -->
        <Border Grid.Row="1" Background="White" CornerRadius="8" Padding="15" Margin="0,0,0,10" BorderBrush="#E0E0E0" BorderThickness="1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="10"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="10"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                
                <StackPanel Grid.Column="0">
                    <TextBlock Text="Fatura / İrsaliye No:" FontWeight="Bold" Foreground="#34495E" Margin="0,0,0,5"/>
                    <TextBox x:Name="txtFaturaNo" FontSize="16" Padding="8" BorderBrush="#BDC3C7" BorderThickness="1"/>
                </StackPanel>
                
                <StackPanel Grid.Column="2">
                    <TextBlock Text="Toptancı / Firma Adı:" FontWeight="Bold" Foreground="#34495E" Margin="0,0,0,5"/>
                    <TextBox x:Name="txtToptanciAdi" FontSize="16" Padding="8" BorderBrush="#BDC3C7" BorderThickness="1"/>
                </StackPanel>

                <StackPanel Grid.Column="4">
                    <TextBlock Text="Fatura Tarihi:" FontWeight="Bold" Foreground="#34495E" Margin="0,0,0,5"/>
                    <DatePicker x:Name="dpFaturaTarihi" FontSize="16" Height="38"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Fatura Kalemleri (Ürünler) -->
        <Border Grid.Row="2" Background="White" CornerRadius="8" Padding="10" Margin="0,0,0,10" BorderBrush="#E0E0E0" BorderThickness="1">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- Hızlı Ürün Ekleme (Barkod) -->
                <Grid Grid.Row="0" Margin="0,0,0,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="10"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    
                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="Ürün Barkodu:" FontWeight="Bold" FontSize="16" Foreground="#34495E" VerticalAlignment="Center" Margin="0,0,10,0"/>
                        <TextBox x:Name="txtBarkod" Width="250" FontSize="18" Padding="5" KeyDown="TxtBarkod_KeyDown"/>
                        <TextBlock Text="(Barkod okutarak hızlı ekle)" FontSize="12" Foreground="#95A5A6" VerticalAlignment="Center" Margin="10,0,0,0"/>
                    </StackPanel>

                    <Button Grid.Column="2" Content="Ürün Bul / Manuel Ekle" Background="#2980B9" Foreground="White" FontWeight="Bold" Padding="15,8" BorderThickness="0" Click="BtnManuelUrunEkle_Click">
                        <Button.Resources><Style TargetType="{x:Type Border}"><Setter Property="CornerRadius" Value="4"/></Style></Button.Resources>
                    </Button>
                </Grid>

                <DataGrid Grid.Row="1" x:Name="dgFaturaKalemleri" AutoGenerateColumns="False" CanUserAddRows="False" SelectionMode="Single"
                          HeadersVisibility="Column" GridLinesVisibility="Horizontal" HorizontalGridLinesBrush="#E0E0E0"
                          RowHeight="40" FontSize="15" AlternatingRowBackground="#F7F9F9" CellEditEnding="DgFaturaKalemleri_CellEditEnding">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Barkod" Binding="{Binding Barkod}" Width="150" IsReadOnly="True"/>
                        <DataGridTextColumn Header="Ürün Adı" Binding="{Binding UrunAdi}" Width="*" IsReadOnly="True"/>
                        <DataGridTextColumn Header="Adet" Binding="{Binding Adet}" Width="100">
                            <DataGridTextColumn.ElementStyle><Style TargetType="TextBlock"><Setter Property="FontWeight" Value="Bold"/></Style></DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>
                        <DataGridTextColumn Header="Alış Fiyatı (TL)" Binding="{Binding AlisFiyati, StringFormat=N2}" Width="120"/>
                        <DataGridTextColumn Header="KDV Oranı (%)" Binding="{Binding KdvOrani}" Width="100"/>
                        <DataGridTextColumn Header="Toplam (TL)" Binding="{Binding ToplamTutar, StringFormat=N2}" Width="120" IsReadOnly="True">
                            <DataGridTextColumn.ElementStyle><Style TargetType="TextBlock"><Setter Property="FontWeight" Value="Bold"/><Setter Property="Foreground" Value="#E74C3C"/></Style></DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>
                        <DataGridTemplateColumn Header="İşlem" Width="80">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Button Content="Sil" Background="#E74C3C" Foreground="White" FontWeight="Bold" Click="BtnKalemSil_Click"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>
            </Grid>
        </Border>

        <!-- Alt Bölüm: Toplamlar ve Kaydet Butonu -->
        <Border Grid.Row="3" Background="#ECF0F1" CornerRadius="8" Padding="15">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="Fatura Toplam Tutar: " FontSize="18" Foreground="#2C3E50" FontWeight="Bold"/>
                    <TextBlock x:Name="txtFaturaToplam" Text="0.00 ₺" FontSize="28" Foreground="#27AE60" FontWeight="Black"/>
                </StackPanel>
                
                <Button Grid.Column="2" Content="💾 FATURAYI KAYDET VE STOĞA EKLE" Background="#27AE60" Foreground="White" FontSize="16" FontWeight="Black" Padding="25,12" BorderThickness="0" Click="BtnKaydet_Click">
                    <Button.Resources><Style TargetType="{x:Type Border}"><Setter Property="CornerRadius" Value="6"/></Style></Button.Resources>
                </Button>
            </Grid>
        </Border>
    </Grid>
</Window>
