<Window x:Class="MarketPOS.Arayuzler.PosBeklemeWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="POS Cihazı Ödeme Onayı" Height="460" Width="520"
        WindowStartupLocation="CenterScreen" ResizeMode="NoResize" Background="#F4F6F9"
        Loaded="Window_Loaded">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Header -->
        <TextBlock Grid.Row="0" Text="💳 POS Cihazı Ödeme İşlemi" FontSize="22" FontWeight="Bold" Foreground="#2C3E50" HorizontalAlignment="Center" Margin="0,0,0,15" />

        <!-- Orta Kart -->
        <Border Grid.Row="1" Background="White" CornerRadius="10" Padding="20" BorderBrush="#3498DB" BorderThickness="2" VerticalAlignment="Center">
            <StackPanel Orientation="Vertical">
                
                <TextBlock Text="GÖNDERİLEN TUTAR" FontSize="13" FontWeight="Bold" Foreground="#7F8C8D" HorizontalAlignment="Center"/>
                <TextBlock x:Name="txtTutar" Text="0.00 ₺" FontSize="36" FontWeight="Black" Foreground="#2980B9" HorizontalAlignment="Center" Margin="0,5,0,15"/>

                <Border Background="#EBF5FB" CornerRadius="6" Padding="15" Margin="0,0,0,15">
                    <StackPanel Orientation="Vertical">
                        <TextBlock x:Name="txtDurumMetni" Text="⏳ POS cihazına tutar gönderildi. Lütfen müşterinin kart okutmasını veya şifre girmesini bekleyin..." 
                                   FontSize="15" FontWeight="Bold" Foreground="#2C3E50" TextWrapping="Wrap" TextAlignment="Center"/>
                        
                        <ProgressBar x:Name="pbİlerleme" IsIndeterminate="True" Height="8" Margin="0,15,0,0"/>
                    </StackPanel>
                </Border>

                <!-- Hata veya Sonuç Bildirim Alanı -->
                <TextBlock x:Name="txtHataAciklamasi" Text="" FontSize="15" FontWeight="Bold" Foreground="#C0392B" TextAlignment="Center" TextWrapping="Wrap" Visibility="Collapsed" Margin="0,0,0,10"/>
            </StackPanel>
        </Border>

        <!-- Alt Simülasyon & İptal Butonları -->
        <StackPanel Grid.Row="2" Margin="0,15,0,0">
            <TextBlock Text="🛠️ Test &amp; Simülasyon Butonları (POS Cihazı Olmadan Test Etmek İçin):" FontSize="11" Foreground="#7F8C8D" Margin="0,0,0,5" HorizontalAlignment="Center"/>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="8" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="8" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Button Grid.Column="0" Content="✅ Test: POS Onayla" Background="#2ECC71" Foreground="White" FontWeight="Bold" FontSize="12" Padding="0,8" BorderThickness="0" Click="BtnTestOnay_Click">
                    <Button.Resources>
                        <Style TargetType="{x:Type Border}">
                            <Setter Property="CornerRadius" Value="4"/>
                        </Style>
                    </Button.Resources>
                </Button>

                <Button Grid.Column="2" Content="❌ Test: Yetersiz Bakiye" Background="#E74C3C" Foreground="White" FontWeight="Bold" FontSize="12" Padding="0,8" BorderThickness="0" Click="BtnTestYetersizBakiye_Click">
                    <Button.Resources>
                        <Style TargetType="{x:Type Border}">
                            <Setter Property="CornerRadius" Value="4"/>
                        </Style>
                    </Button.Resources>
                </Button>

                <Button Grid.Column="4" Content="⏹️ İptal Et (ESC)" Background="#7F8C8D" Foreground="White" FontWeight="Bold" FontSize="12" Padding="0,8" BorderThickness="0" Click="BtnIptal_Click" IsCancel="True">
                    <Button.Resources>
                        <Style TargetType="{x:Type Border}">
                            <Setter Property="CornerRadius" Value="4"/>
                        </Style>
                    </Button.Resources>
                </Button>
            </Grid>
        </StackPanel>
    </Grid>
</Window>
