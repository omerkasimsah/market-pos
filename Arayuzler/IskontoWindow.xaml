<Window x:Class="MarketPOS.Arayuzler.IskontoWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="İskonto Uygula" Height="420" Width="450" 
        WindowStartupLocation="CenterScreen" ResizeMode="NoResize" Background="#F4F6F9"
        Loaded="Window_Loaded">
    
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <Border Padding="25">
            <StackPanel Orientation="Vertical">
                
                <TextBlock Text="Sepet İskontosu Uygula" FontSize="20" FontWeight="Bold" Foreground="#34495E" HorizontalAlignment="Center" Margin="0,0,0,15" />
                
                <TextBlock x:Name="txtMevcutToplam" Text="Mevcut Toplam: 0,00 ₺" FontSize="16" Foreground="#7F8C8D" Margin="0,0,0,20" TextWrapping="Wrap" HorizontalAlignment="Center" />

                <!-- İskonto Türü Seçimi -->
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,15">
                    <RadioButton x:Name="rbYuzde" Content="Yüzde (%)" FontSize="16" FontWeight="Bold" Margin="0,0,20,0" IsChecked="True" Checked="Radio_Checked" />
                    <RadioButton x:Name="rbTutar" Content="Tutar (TL)" FontSize="16" FontWeight="Bold" Checked="Radio_Checked" />
                </StackPanel>

                <!-- Değer Girişi -->
                <TextBlock x:Name="lblDeger" Text="İskonto Yüzdesi (%):" FontWeight="Bold" Foreground="#34495E" Margin="0,0,0,5" />
                <TextBox x:Name="txtDeger" FontSize="20" Padding="10" Margin="0,0,0,15" BorderBrush="#BDC3C7" BorderThickness="1" />

                <!-- Uygulanan İndirim & Yeni Toplam Önizleme -->
                <Border Background="#E8F8F5" BorderBrush="#1ABC9C" BorderThickness="1" CornerRadius="5" Padding="10" Margin="0,0,0,20">
                    <StackPanel>
                        <TextBlock x:Name="txtIndirimTutari" Text="İndirim: 0,00 ₺" Foreground="#16A085" FontWeight="Bold" Margin="0,0,0,5" />
                        <TextBlock x:Name="txtYeniToplam" Text="Yeni Toplam: 0,00 ₺" Foreground="#C0392B" FontSize="18" FontWeight="Bold" />
                    </StackPanel>
                </Border>

                <!-- Butonlar -->
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="10" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    
                    <Button Grid.Column="0" Content="Uygula (Enter)" Background="#2ECC71" Foreground="White" FontSize="16" FontWeight="Bold" Padding="0,12" BorderThickness="0" Click="Uygula_Click" IsDefault="True">
                        <Button.Resources>
                            <Style TargetType="{x:Type Border}">
                                <Setter Property="CornerRadius" Value="5"/>
                            </Style>
                        </Button.Resources>
                    </Button>
                    
                    <Button Grid.Column="2" Content="İptal (ESC)" Background="#E74C3C" Foreground="White" FontSize="16" FontWeight="Bold" Padding="0,12" BorderThickness="0" Click="Iptal_Click" IsCancel="True">
                        <Button.Resources>
                            <Style TargetType="{x:Type Border}">
                                <Setter Property="CornerRadius" Value="5"/>
                            </Style>
                        </Button.Resources>
                    </Button>
                </Grid>
            </StackPanel>
        </Border>
    </ScrollViewer>
</Window>
