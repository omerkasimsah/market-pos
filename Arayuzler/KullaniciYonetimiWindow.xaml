<Window x:Class="MarketPOS.Arayuzler.KullaniciYonetimiWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="👤 Kullanıcı / Personel Yönetimi" Height="560" Width="900"
        WindowStartupLocation="CenterScreen" Background="#F4F6F9" FontFamily="Segoe UI" FontSize="15">
    <Grid Margin="15">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="15"/>
            <ColumnDefinition Width="320"/>
        </Grid.ColumnDefinitions>

        <Border Grid.ColumnSpan="3" Background="#2C3E50" CornerRadius="8" Padding="12" Margin="0,0,0,10">
            <TextBlock Text="👤 KULLANICI / PERSONEL YÖNETİMİ" FontSize="20" FontWeight="Bold" Foreground="White"/>
        </Border>

        <DataGrid Grid.Row="1" x:Name="dgKullanicilar" AutoGenerateColumns="False" CanUserAddRows="False" IsReadOnly="True"
                  SelectionMode="Single" HeadersVisibility="Column" RowHeight="34" AlternatingRowBackground="#F7F9F9"
                  SelectionChanged="DgKullanicilar_SelectionChanged">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Kullanıcı Adı" Binding="{Binding KullaniciAdi}" Width="140"/>
                <DataGridTextColumn Header="Ad Soyad" Binding="{Binding AdSoyad}" Width="*"/>
                <DataGridTextColumn Header="Rol" Binding="{Binding RolGorunum}" Width="100"/>
                <DataGridTextColumn Header="Durum" Binding="{Binding DurumGorunum}" Width="80"/>
            </DataGrid.Columns>
        </DataGrid>

        <Border Grid.Row="1" Grid.Column="2" Background="White" CornerRadius="8" Padding="15" BorderBrush="#E0E0E0" BorderThickness="1">
            <StackPanel>
                <TextBlock x:Name="txtFormBaslik" Text="➕ Yeni Kullanıcı" FontSize="17" FontWeight="Bold" Foreground="#2C3E50" Margin="0,0,0,10"/>

                <TextBlock Text="Kullanıcı Adı:" FontWeight="Bold" Foreground="#34495E"/>
                <TextBox x:Name="txtKullaniciAdi" Padding="5" Margin="0,3,0,8"/>

                <TextBlock Text="Ad Soyad:" FontWeight="Bold" Foreground="#34495E"/>
                <TextBox x:Name="txtAdSoyad" Padding="5" Margin="0,3,0,8"/>

                <TextBlock x:Name="lblSifre" Text="Şifre:" FontWeight="Bold" Foreground="#34495E" TextWrapping="Wrap"/>
                <PasswordBox x:Name="txtSifre" Padding="5" Margin="0,3,0,8"/>

                <TextBlock Text="Rol:" FontWeight="Bold" Foreground="#34495E"/>
                <ComboBox x:Name="cmbRol" Margin="0,3,0,8" SelectedIndex="0">
                    <ComboBoxItem Content="Kasiyer" Tag="Kasiyer"/>
                    <ComboBoxItem Content="Yönetici" Tag="Yonetici"/>
                </ComboBox>

                <CheckBox x:Name="chkAktif" Content="Hesap aktif (giriş yapabilir)" IsChecked="True" Margin="0,5,0,15"/>

                <Button Content="💾 Kaydet" Background="#27AE60" Foreground="White" FontWeight="Bold" Padding="0,10" BorderThickness="0" Margin="0,0,0,8" Click="BtnKaydet_Click"/>
                <Button Content="➕ Yeni Kullanıcı Formu" Background="#3498DB" Foreground="White" FontWeight="Bold" Padding="0,8" BorderThickness="0" Click="BtnYeni_Click"/>
            </StackPanel>
        </Border>
    </Grid>
</Window>
