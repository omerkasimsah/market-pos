<UserControl x:Class="MarketPOS.Arayuzler.AyarlarUserControl"
              xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
              xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
              xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
              xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
              mc:Ignorable="d" 
              d:DesignHeight="650" d:DesignWidth="1024"
              Background="#F4F6F9" FontFamily="Segoe UI" FontSize="16"
              Loaded="UserControl_Loaded">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Grid Grid.Row="0" Margin="0,0,0,15">
            <TextBlock Text="⚙️ Sistem, Donanım ve Bağlantı Kılavuzları" FontSize="24" FontWeight="Bold" Foreground="#2C3E50" VerticalAlignment="Center"/>
            <Button Content="🏠 Ana Menü" Background="#1ABC9C" Foreground="White" FontWeight="Bold" FontSize="14" Padding="12,6" HorizontalAlignment="Right" VerticalAlignment="Center" BorderThickness="0" Click="BtnAnaMenu_Click">
                <Button.Resources>
                    <Style TargetType="{x:Type Border}">
                        <Setter Property="CornerRadius" Value="6"/>
                    </Style>
                </Button.Resources>
            </Button>
        </Grid>

        <!-- Tabbed Navigation -->
        <TabControl Grid.Row="1" Background="White" BorderBrush="#CBD5E1" BorderThickness="1">
            
            <!-- SEKMELERE ÖZEL MODERN SEKMELER STİLİ -->
            <TabControl.Resources>
                <Style TargetType="TabItem">
                    <Setter Property="FontSize" Value="15"/>
                    <Setter Property="FontWeight" Value="Bold"/>
                    <Setter Property="Padding" Value="16,10"/>
                    <Setter Property="Foreground" Value="#2C3E50"/>
                </Style>
            </TabControl.Resources>

            <!-- TAB 1: GENEL AYARLAR -->
            <TabItem Header="⚙️ Donanım Ayarları">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="20">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="500"/>
                            <ColumnDefinition Width="30"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <!-- Sol: Ayar Formu -->
                        <StackPanel Grid.Column="0" Orientation="Vertical">
                            <TextBlock Text="Dükkan / İşletme Unvanı:" FontWeight="Bold" Foreground="#34495E" Margin="0,0,0,5"/>
                            <TextBox x:Name="txtDukkanAdi" FontSize="16" Padding="8" Margin="0,0,0,15" BorderBrush="#BDC3C7" BorderThickness="1"/>

                            <TextBlock Text="Fiş Alt Notu (Teşekkür Mesajı):" FontWeight="Bold" Foreground="#34495E" Margin="0,0,0,5"/>
                            <TextBox x:Name="txtFisAltNotu" FontSize="15" Padding="8" Margin="0,0,0,15" BorderBrush="#BDC3C7" BorderThickness="1"/>

                            <TextBlock Text="ÖKC / POS Cihazı Seri Port (COM):" FontWeight="Bold" Foreground="#34495E" Margin="0,0,0,5"/>
                            <Grid Margin="0,0,0,15">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="10"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <ComboBox x:Name="cmbComPort" Grid.Column="0" FontSize="15" Height="38">
                                    <ComboBoxItem Content="COM1" />
                                    <ComboBoxItem Content="COM2" />
                                    <ComboBoxItem Content="COM3" IsSelected="True" />
                                    <ComboBoxItem Content="COM4" />
                                    <ComboBoxItem Content="COM5" />
                                    <ComboBoxItem Content="COM6" />
                                    <ComboBoxItem Content="COM7" />
                                </ComboBox>
                                <Button Grid.Column="2" Content="⚡ POS Test Ping" Background="#3498DB" Foreground="White" FontWeight="Bold" FontSize="13" Padding="10,0" BorderThickness="0" Click="BtnTestPos_Click">
                                    <Button.Resources>
                                        <Style TargetType="{x:Type Border}"><Setter Property="CornerRadius" Value="4"/></Style>
                                    </Button.Resources>
                                </Button>
                            </Grid>

                            <TextBlock Text="Termal Fiş Yazıcısı (ESC/POS):" FontWeight="Bold" Foreground="#34495E" Margin="0,0,0,5"/>
                            <Grid Margin="0,0,0,25">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="10"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <ComboBox x:Name="cmbYazici" Grid.Column="0" FontSize="15" Height="38"/>
                                <Button Grid.Column="2" Content="🖨️ Deneme Fişi Yazdır" Background="#E67E22" Foreground="White" FontWeight="Bold" FontSize="13" Padding="10,0" BorderThickness="0" Click="BtnTestYazici_Click">
                                    <Button.Resources>
                                        <Style TargetType="{x:Type Border}"><Setter Property="CornerRadius" Value="4"/></Style>
                                    </Button.Resources>
                                </Button>
                            </Grid>

                            <Button Content="💾 Tüm Ayarları Kaydet" Background="#2ECC71" Foreground="White" FontSize="17" FontWeight="Bold" Padding="0,12" BorderThickness="0" Click="BtnKaydet_Click">
                                <Button.Resources>
                                    <Style TargetType="{x:Type Border}"><Setter Property="CornerRadius" Value="5"/></Style>
                                </Button.Resources>
                            </Button>
                        </StackPanel>

                        <!-- Sağ: Hızlı Bilgilendirme -->
                        <Border Grid.Column="2" Background="#F8FAFC" CornerRadius="8" Padding="15" BorderBrush="#E2E8F0" BorderThickness="1" VerticalAlignment="Top">
                            <StackPanel>
                                <TextBlock Text="💡 Hızlı Bağlantı Özeti" FontSize="18" FontWeight="Bold" Foreground="#1E293B" Margin="0,0,0,10"/>
                                <TextBlock Text="• POS cihazınız RS232 seri kablo veya USB-Serial dönüştürücü ile bağlı olmalıdır." FontSize="14" Foreground="#475569" TextWrapping="Wrap" Margin="0,0,0,8"/>
                                <TextBlock Text="• Termal yazıcınız Windows Aygıtlar ve Yazıcılar kısmında yüklü ise otomatik tespit edilir." FontSize="14" Foreground="#475569" TextWrapping="Wrap" Margin="0,0,0,8"/>
                                <TextBlock Text="• Detaylı donanım bağlantı kılavuzları için üstteki sekmeleri inceleyebilirsiniz." FontSize="14" Foreground="#0284C7" FontWeight="Bold" TextWrapping="Wrap"/>
                            </StackPanel>
                        </Border>
                    </Grid>
                </ScrollViewer>
            </TabItem>

            <!-- TAB 2: POS CİHAZI BAĞLANTI KILAVUZU -->
            <TabItem Header="💳 POS Cihazı (COM Port) Kılavuzu">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="25">
                    <StackPanel MaxWidth="900" HorizontalAlignment="Left">
                        <TextBlock Text="💳 ÖKC ve Banka POS Terminali Haberleşme Rehberi" FontSize="20" FontWeight="Bold" Foreground="#1E293B" Margin="0,0,0,15"/>

                        <Border Background="#E0F2FE" CornerRadius="8" Padding="15" Margin="0,0,0,15" BorderBrush="#0284C7" BorderThickness="1">
                            <StackPanel>
                                <TextBlock Text="📌 Haberleşme Protokolü ve STX/ETX Yapısı" FontSize="16" FontWeight="Bold" Foreground="#0369A1" Margin="0,0,0,5"/>
                                <TextBlock Text="Sistem, seri port (COM1 - COM7) üzerinden STX/ETX (0x02/0x03) standart mesajlaşma paketini kullanır. F2: Kredi Kartı ile satış onaylandığında tutar otomatik olarak POS cihazının ekranına yansır." FontSize="14" Foreground="#0F172A" TextWrapping="Wrap"/>
                            </StackPanel>
                        </Border>

                        <TextBlock Text="Adım Adım Bağlantı Kurulumu:" FontSize="17" FontWeight="Bold" Foreground="#334155" Margin="0,10,0,8"/>
                        <TextBlock Text="1. POS Cihazınızın haberleşme kablosunu (RS232 veya USB Seri Çevirici) bilgisayarınıza bağlayın." FontSize="14" Foreground="#475569" Margin="0,0,0,5"/>
                        <TextBlock Text="2. Windows 'Aygıt Yöneticisi -> Bağlantı Noktaları (COM &amp; LPT)' kısmından bağlı olan COM port numarasını öğrenin (Örn: COM3)." FontSize="14" Foreground="#475569" Margin="0,0,0,5"/>
                        <TextBlock Text="3. POS cihazının seri port parametrelerini varsayılan '9600 BaudRate, 8 Data Bits, No Parity, 1 Stop Bit (9600 8N1)' yapın." FontSize="14" Foreground="#475569" Margin="0,0,0,5"/>
                        <TextBlock Text="4. 'Donanım Ayarları' sekmesinden ilgili COM portunu seçip 'Kaydet' butonuna basın." FontSize="14" Foreground="#475569" Margin="0,0,0,15"/>

                        <TextBlock Text="🚨 Yetersiz Bakiye ve Onay Durumları:" FontSize="17" FontWeight="Bold" Foreground="#334155" Margin="0,10,0,8"/>
                        <Border Background="#FEF2F2" CornerRadius="8" Padding="15" BorderBrush="#EF4444" BorderThickness="1">
                            <StackPanel>
                                <TextBlock Text="• POS İşlemi Onaylandığında: Sistem otomatik döküm alır, stoğu FIFO düşer ve kasaya işler." FontSize="14" Foreground="#991B1B" Margin="0,0,0,5"/>
                                <TextBlock Text="• Yetersiz Bakiye / Kart İptali / Hatalı PIN: Ekranda kırmızı '❌ POS İşlemi Reddedildi: Yetersiz Bakiye' uyarısı çıkar. Satış TAMAMLANMAZ, sepetteki ürünler sıfırlanmaz. Kasiyer başka bir kart deneyebilir veya Nakit satışa geçebilir." FontSize="14" Foreground="#991B1B" TextWrapping="Wrap"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- TAB 3: TERMAL YAZICI KILAVUZU -->
            <TabItem Header="🖨️ Termal Fiş Yazıcısı Kılavuzu">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="25">
                    <StackPanel MaxWidth="900" HorizontalAlignment="Left">
                        <TextBlock Text="🖨️ ESC/POS Termal Fiş Yazıcısı Kurulum ve Sürücü Kılavuzu" FontSize="20" FontWeight="Bold" Foreground="#1E293B" Margin="0,0,0,15"/>

                        <Border Background="#F0FDF4" CornerRadius="8" Padding="15" Margin="0,0,0,15" BorderBrush="#22C55E" BorderThickness="1">
                            <StackPanel>
                                <TextBlock Text="📌 Desteklenen Yazıcı Türleri" FontSize="16" FontWeight="Bold" Foreground="#15803D" Margin="0,0,0,5"/>
                                <TextBlock Text="Tüm 80mm ve 58mm ESC/POS uyumlu USB, Ethernet, Bluetooth veya LPT termal fiş yazıcıları (Xprinter, Bixolon, Epson, Rongta, HPRT vb.) tam uyumlu çalışır." FontSize="14" Foreground="#0F172A" TextWrapping="Wrap"/>
                            </StackPanel>
                        </Border>

                        <TextBlock Text="Adım Adım Yazıcı Tanımlama:" FontSize="17" FontWeight="Bold" Foreground="#334155" Margin="0,10,0,8"/>
                        <TextBlock Text="1. Yazıcınızın Windows sürücüsünü (Driver) kurun ve bilgisayara USB ile bağlayın." FontSize="14" Foreground="#475569" Margin="0,0,0,5"/>
                        <TextBlock Text="2. Windows 'Yazıcılar ve Tarayıcılar' altında yazıcınızın göründüğünden ve 'Sınama Sayfası Yazdır' yapabildiğinizden emin olun." FontSize="14" Foreground="#475569" Margin="0,0,0,5"/>
                        <TextBlock Text="3. Programın 'Donanım Ayarları' sekmesindeki 'Termal Fiş Yazıcısı' açılır menüsünden cihazınızı seçin." FontSize="14" Foreground="#475569" Margin="0,0,0,5"/>
                        <TextBlock Text="4. '🖨️ Deneme Fişi Yazdır' butonuna basarak döküm kalitesini ve kağıt kesmeyi test edin." FontSize="14" Foreground="#475569" Margin="0,0,0,15"/>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- TAB 4: TERAZİ VE BARKOD OKUYUCU REHBERİ -->
            <TabItem Header="⚖️ Terazi &amp; Barkod Okuyucu Rehberi">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="25">
                    <StackPanel MaxWidth="900" HorizontalAlignment="Left">
                        <TextBlock Text="⚖️ Gramajlı Terazi ve Barkod Okuyucu Entegrasyonu" FontSize="20" FontWeight="Bold" Foreground="#1E293B" Margin="0,0,0,15"/>

                        <Border Background="#FEF3C7" CornerRadius="8" Padding="15" Margin="0,0,0,15" BorderBrush="#F59E0B" BorderThickness="1">
                            <StackPanel>
                                <TextBlock Text="🔍 Barkod Okuyucu Yapılandırması (USB HID)" FontSize="16" FontWeight="Bold" Foreground="#B45309" Margin="0,0,0,5"/>
                                <TextBlock Text="USB Barkod Okuyucular tak-çalıştır (HID klavye) modunda çalışır. Satış ekranında barkod okutulduğunda ürün otomatik sepete eklenir. Okuyucunuzun sonuna 'ENTER / Carriage Return' karakteri ekli olduğundan emin olun." FontSize="14" Foreground="#0F172A" TextWrapping="Wrap"/>
                            </StackPanel>
                        </Border>

                        <TextBlock Text="⚖️ Gramajlı Terazi Barkod Mantığı (27 ile Başlayan Barkodlar):" FontSize="17" FontWeight="Bold" Foreground="#334155" Margin="0,10,0,8"/>
                        <TextBlock Text="• Teraziden çıkan '27XXXXX005508' formatındaki barkodlar otomasyon tarafından otomatik çözümlenir." FontSize="14" Foreground="#475569" Margin="0,0,0,5"/>
                        <TextBlock Text="• İlk 2 hane: 27 (Gramajlı Barkod Bayrağı)" FontSize="14" Foreground="#475569" Margin="0,0,0,5"/>
                        <TextBlock Text="• Sonraki 5 hane: Ürün Kodu (Örn: 00123)" FontSize="14" Foreground="#475569" Margin="0,0,0,5"/>
                        <TextBlock Text="• Sonraki 5 hane: Gramaj (Örn: 00550 = 0.550 kg)" FontSize="14" Foreground="#475569" Margin="0,0,0,15"/>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>
        </TabControl>
    </Grid>
</UserControl>
