<Window x:Class="MarketPOS.Arayuzler.MusteriSecimWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Müşteri Seçimi (Veresiye)" Height="450" Width="400" 
        WindowStartupLocation="CenterScreen" ResizeMode="NoResize" Background="#F4F6F9"
        Loaded="Window_Loaded">
    
    <Grid Margin="15">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        
        <!-- Arama Alanı -->
        <StackPanel Grid.Row="0" Margin="0,0,0,10">
            <TextBlock Text="Müşteri Ara:" FontWeight="Bold" Foreground="#34495E" Margin="0,0,0,5" />
            <TextBox x:Name="txtArama" FontSize="16" Padding="8" BorderBrush="#BDC3C7" BorderThickness="1" TextChanged="txtArama_TextChanged" />
        </StackPanel>
        
        <!-- Müşteri Listesi -->
        <DataGrid Grid.Row="1" x:Name="dgMusteriler" AutoGenerateColumns="False" CanUserAddRows="False" IsReadOnly="True"
                  HeadersVisibility="Column" GridLinesVisibility="Horizontal" HorizontalGridLinesBrush="#E0E0E0"
                  RowHeight="35" FontSize="14" Background="White" BorderThickness="1" BorderBrush="#BDC3C7"
                  AlternatingRowBackground="#F9F9F9" MouseDoubleClick="dgMusteriler_MouseDoubleClick">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Ad Soyad" Binding="{Binding AdSoyad}" Width="*" />
                <DataGridTextColumn Header="Borç" Binding="{Binding BorcMiktari, StringFormat={}{0:N2} ₺}" Width="100">
                    <DataGridTextColumn.ElementStyle>
                        <Style TargetType="TextBlock">
                            <Setter Property="HorizontalAlignment" Value="Right" />
                        </Style>
                    </DataGridTextColumn.ElementStyle>
                </DataGridTextColumn>
            </DataGrid.Columns>
        </DataGrid>

        <!-- Alt Kısım -->
        <Grid Grid.Row="2" Margin="0,15,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="10" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            
            <Button Grid.Column="0" Content="Seç" Background="#2ECC71" Foreground="White" FontSize="16" FontWeight="Bold" Padding="0,10" BorderThickness="0" Click="Sec_Click" IsDefault="True" />
            <Button Grid.Column="2" Content="İptal (ESC)" Background="#E74C3C" Foreground="White" FontSize="16" FontWeight="Bold" Padding="0,10" BorderThickness="0" Click="Iptal_Click" IsCancel="True" />
        </Grid>
    </Grid>
</Window>
