<Window x:Class="MarketPOS.Arayuzler.UrunEkleDuzenleWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Gelişmiş Ürün Kaydı &amp; Fotoğraf Ekleme" WindowState="Maximized"
        WindowStartupLocation="CenterScreen" Background="#F4F6F9"
        Loaded="Window_Loaded">

    <Grid Margin="25">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Üst Başlık -->
        <Border Grid.Row="0" Background="#2C3E50" CornerRadius="8" Padding="15" Margin="0,0,0,15">
            <TextBlock x:Name="txtBaslik" Text="GELİŞMİŞ ÜRÜN KAYDI" FontSize="24" FontWeight="Black" Foreground="White" HorizontalAlignment="Center"/>
        </Border>

        <!-- Orta Alan: İki Sütun -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="6*"/> <!-- Sol: Ürün Bilgileri -->
                <ColumnDefinition Width="4*"/> <!-- Sağ: Fotoğraf -->
            </Grid.ColumnDefinitions>

            <!-- SOL SÜTUN: VERİ GİRİŞİ -->
            <ScrollViewer Grid.Column="0" VerticalScrollBarVisibility="Auto" Margin="0,0,15,0">
                <StackPanel Orientation="Vertical">
                    
                    <!-- Temel Bilgiler -->
                    <Border Background="White" CornerRadius="8" Padding="15" Margin="0,0,0,15" BorderBrush="#E0E0E0" BorderThickness="1">
                        <StackPanel>
                            <TextBlock Text="📦 Temel Ürün Bilgileri" FontWeight="Bold" Foreground="#2980B9" FontSize="16" Margin="0,0,0,15"/>
                            
                            <Grid Margin="0,0,0,15">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="10" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="Barkod:" FontWeight="Bold" Foreground="#34495E" Margin="0,0,0,5" />
                                    <TextBox x:Name="txtBarkod" FontSize="18" Padding="10" BorderBrush="#BDC3C7" BorderThickness="1" />
                                </StackPanel>
                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="Ürün Adı:" FontWeight="Bold" Foreground="#34495E" Margin="0,0,0,5" />
                                    <TextBox x:Name="txtUrunAdi" FontSize="18" Padding="10" BorderBrush="#BDC3C7" BorderThickness="1" />
                                </StackPanel>
                            </Grid>

                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="10" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="Kategori:" FontWeight="Bold" Foreground="#34495E" Margin="0,0,0,5" />
                                    <TextBox x:Name="txtKategori" FontSize="18" Padding="10" BorderBrush="#BDC3C7" BorderThickness="1" />
                                </StackPanel>
                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="Firma / Tedarikçi:" FontWeight="Bold" Foreground="#34495E" Margin="0,0,0,5" />
                                    <TextBox x:Name="txtFirma" FontSize="18" Padding="10" BorderBrush="#BDC3C7" BorderThickness="1" />
                                </StackPanel>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <!-- Alış Fiyatı & KDV Ayarları -->
                    <Border Background="#EAECEE" CornerRadius="8" Padding="15" Margin="0,0,0,15">
                        <StackPanel>
                            <TextBlock Text="💵 Alış Fiyatı &amp; KDV Hesaplama" FontWeight="Bold" Foreground="#2C3E50" FontSize="16" Margin="0,0,0,15"/>
                            
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="15" />
                                    <ColumnDefinition Width="140" />
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="Alış Fiyatı (TL):" FontWeight="Bold" Foreground="#34495E" Margin="0,0,0,5" />
                                    <TextBox x:Name="txtAlisFiyati" FontSize="18" Padding="10" BorderBrush="#BDC3C7" BorderThickness="1" TextChanged="HesaplamaParametreleri_Changed" />
                                </StackPanel>

                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="KDV Oranı:" FontWeight="Bold" Foreground="#34495E" Margin="0,0,0,5" />
                                    <ComboBox x:Name="cmbKdvOrani" FontSize="16" Height="44" SelectionChanged="HesaplamaParametreleri_Changed">
                                        <ComboBoxItem Content="%1 (Temel Gıda)" />
                                        <ComboBoxItem Content="%10 (Gıda / Apre)" IsSelected="True" />
                                        <ComboBoxItem Content="%20 (Diğer)" />
                                    </ComboBox>
                                </StackPanel>
                            </Grid>

                            <CheckBox x:Name="chkKdvDahil" Content="Girilen Alış Fiyatına KDV Dahil" IsChecked="True" FontWeight="Bold" FontSize="14" Foreground="#27AE60" Margin="0,15,0,15" Click="HesaplamaParametreleri_Changed"/>

                            <Grid Margin="0,5,0,0">
                                <TextBlock x:Name="lblNetAlis" Text="Net Alış: 0.00 ₺" Foreground="#7F8C8D" FontWeight="Bold" FontSize="16" HorizontalAlignment="Left"/>
                                <TextBlock x:Name="lblKdvTutari" Text="KDV Tutarı: 0.00 ₺" Foreground="#7F8C8D" FontWeight="Bold" FontSize="16" HorizontalAlignment="Right"/>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <!-- Satış Fiyatı & Canlı Kar Marjı -->
                    <Border Background="#E8F8F5" CornerRadius="8" Padding="15" Margin="0,0,0,15" BorderBrush="#2ECC71" BorderThickness="2">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="15" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0">
                                <TextBlock Text="Satış Fiyatı (TL):" FontWeight="Bold" FontSize="16" Foreground="#27AE60" Margin="0,0,0,5" />
                                <TextBox x:Name="txtSatisFiyati" FontSize="24" FontWeight="Black" Padding="10" BorderBrush="#2ECC71" BorderThickness="2" TextChanged="HesaplamaParametreleri_Changed" />
                            </StackPanel>

                            <StackPanel Grid.Column="2" VerticalAlignment="Center">
                                <TextBlock Text="Hesaplanan Kar Marjı:" FontWeight="Bold" FontSize="14" Foreground="#34495E" Margin="0,0,0,5" />
                                <Border Background="#2ECC71" CornerRadius="6" Padding="10,12">
                                    <TextBlock x:Name="lblKarMarji" Text="%0.0 Kar" Foreground="White" FontSize="20" FontWeight="Black" HorizontalAlignment="Center"/>
                                </Border>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- SKT ve Stok Parti Girişi -->
                    <Border Background="#FEF9E7" CornerRadius="8" Padding="15" Margin="0,0,0,15" BorderBrush="#F1C40F" BorderThickness="1">
                        <StackPanel>
                            <TextBlock Text="📅 SKT &amp; Stok Bilgisi" FontWeight="Bold" Foreground="#D35400" FontSize="16" Margin="0,0,0,10"/>
                            
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="10" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="10" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="Stok Adedi:" FontWeight="Bold" Foreground="#34495E" Margin="0,0,0,5" />
                                    <TextBox x:Name="txtStokMiktari" FontSize="18" Padding="10" BorderBrush="#BDC3C7" BorderThickness="1" />
                                </StackPanel>

                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="Parti / Lot No:" FontWeight="Bold" Foreground="#34495E" Margin="0,0,0,5" />
                                    <TextBox x:Name="txtPartiNo" FontSize="18" Padding="10" BorderBrush="#BDC3C7" BorderThickness="1" />
                                </StackPanel>

                                <StackPanel Grid.Column="4">
                                    <TextBlock Text="SKT Tarihi:" FontWeight="Bold" Foreground="#34495E" Margin="0,0,0,5" />
                                    <DatePicker x:Name="dpSktTarihi" Height="44" FontSize="16" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Grid>
                        </StackPanel>
                    </Border>

                </StackPanel>
            </ScrollViewer>

            <!-- SAĞ SÜTUN: FOTOĞRAF ALANI -->
            <Border Grid.Column="1" Background="White" CornerRadius="8" Padding="15" BorderBrush="#E0E0E0" BorderThickness="1">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Text="📷 ÜRÜN FOTOĞRAFI" FontSize="18" FontWeight="Black" Foreground="#8E44AD" HorizontalAlignment="Center" Margin="0,0,0,15"/>
                    
                    <Border Grid.Row="1" Background="#F8F9F9" BorderBrush="#BDC3C7" BorderThickness="2" CornerRadius="8" Margin="0,0,0,15">
                        <Grid>
                            <TextBlock x:Name="txtFotoYerTutucu" Text="Fotoğraf Seçilmedi" Foreground="#95A5A6" FontSize="18" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            <Image x:Name="imgUrunFoto" Stretch="Uniform" Margin="5"/>
                        </Grid>
                    </Border>

                    <Grid Grid.Row="2">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="10"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <Button Grid.Column="0" Content="📸 FOTOĞRAF SEÇ" Background="#8E44AD" Foreground="White" FontSize="15" FontWeight="Bold" Padding="0,12" BorderThickness="0" Click="BtnFotoSec_Click">
                            <Button.Resources><Style TargetType="{x:Type Border}"><Setter Property="CornerRadius" Value="6"/></Style></Button.Resources>
                        </Button>
                        <Button Grid.Column="2" Content="🗑 SİL" Background="#E74C3C" Foreground="White" FontSize="15" FontWeight="Bold" Padding="15,12" BorderThickness="0" Click="BtnFotoSil_Click">
                            <Button.Resources><Style TargetType="{x:Type Border}"><Setter Property="CornerRadius" Value="6"/></Style></Button.Resources>
                        </Button>
                    </Grid>
                </Grid>
            </Border>
        </Grid>

        <!-- Alt Alan: Kaydet ve İptal -->
        <Border Grid.Row="2" Background="#ECF0F1" CornerRadius="8" Padding="15" Margin="0,15,0,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="15" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                
                <Button Grid.Column="0" Content="💾 ÜRÜNÜ KAYDET" Background="#27AE60" Foreground="White" FontSize="18" FontWeight="Black" Padding="0,15" BorderThickness="0" Click="Kaydet_Click" IsDefault="True">
                    <Button.Resources><Style TargetType="{x:Type Border}"><Setter Property="CornerRadius" Value="6"/></Style></Button.Resources>
                </Button>
                
                <Button Grid.Column="2" Content="❌ İPTAL (ESC)" Background="#E74C3C" Foreground="White" FontSize="18" FontWeight="Black" Padding="0,15" BorderThickness="0" Click="Iptal_Click" IsCancel="True">
                    <Button.Resources><Style TargetType="{x:Type Border}"><Setter Property="CornerRadius" Value="6"/></Style></Button.Resources>
                </Button>
            </Grid>
        </Border>

    </Grid>
</Window>
