<Window x:Class="MarketPOS.Arayuzler.RaporlarWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Detaylı Satış Raporları &amp; Fiş Bulma - SüperMarket POS" Height="768" Width="1100" WindowState="Maximized"
        Background="#F4F6F9" FontFamily="Segoe UI" FontSize="16"
        Loaded="Window_Loaded">

    <Grid Margin="15">
        <Grid.RowDefinitions>
            <RowDefinition Height="60" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0" Background="#2C3E50" CornerRadius="8" Padding="15,10" Margin="0,0,0,10">
            <Grid>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="📈 DETAYLI RAPORLAR VE FİŞ SORGULAMA" Foreground="White" FontSize="20" FontWeight="Bold"/>
                </StackPanel>
                <Button Content="Pencereyi Kapat" Background="#E74C3C" Foreground="White" FontWeight="Bold" HorizontalAlignment="Right" Padding="12,5" BorderThickness="0" Click="BtnKapat_Click">
                    <Button.Resources>
                        <Style TargetType="{x:Type Border}">
                            <Setter Property="CornerRadius" Value="4"/>
                        </Style>
                    </Button.Resources>
                </Button>
            </Grid>
        </Border>

        <!-- TabControl -->
        <TabControl Grid.Row="1" Background="Transparent" BorderThickness="0">

            <!-- TAB 1: ÜRÜN BAZLI SATIŞ RAPORU -->
            <TabItem Header="📊 Ürün Bazlı Satış Raporu" FontSize="16" FontWeight="Bold" Padding="15,8">
                <Grid Margin="0,15,0,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <!-- Filtre Paneli -->
                    <Border Grid.Row="0" Background="White" CornerRadius="8" Padding="15" Margin="0,0,0,15" BorderBrush="#BDC3C7" BorderThickness="1">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="Tarih Aralığı:" FontWeight="Bold" VerticalAlignment="Center" Margin="0,0,10,0"/>
                            
                            <Button Content="Bugün" Background="#3498DB" Foreground="White" Padding="12,6" Margin="0,0,5,0" FontWeight="Bold" BorderThickness="0" Click="BtnRaporBugun_Click"/>
                            <Button Content="Bu Hafta" Background="#2ECC71" Foreground="White" Padding="12,6" Margin="0,0,5,0" FontWeight="Bold" BorderThickness="0" Click="BtnRaporHafta_Click"/>
                            <Button Content="Bu Ay" Background="#9B59B6" Foreground="White" Padding="12,6" Margin="0,0,15,0" FontWeight="Bold" BorderThickness="0" Click="BtnRaporAy_Click"/>

                            <TextBlock Text="Başlangıç:" VerticalAlignment="Center" Margin="10,0,5,0"/>
                            <DatePicker x:Name="dpBaslangic" Height="36" Width="130" VerticalAlignment="Center"/>

                            <TextBlock Text="Bitiş:" VerticalAlignment="Center" Margin="10,0,5,0"/>
                            <DatePicker x:Name="dpBitis" Height="36" Width="130" VerticalAlignment="Center"/>

                            <Button Content="Sorgula" Background="#1ABC9C" Foreground="White" Padding="15,6" Margin="15,0,10,0" FontWeight="Bold" BorderThickness="0" Click="BtnRaporSorgula_Click"/>
                            <Button Content="📊 CSV / Excel Dışa Aktar" Background="#F39C12" Foreground="White" Padding="15,6" FontWeight="Bold" BorderThickness="0" Click="BtnCsvAktar_Click"/>
                        </StackPanel>
                    </Border>

                    <!-- Özet Kartlar -->
                    <Grid Grid.Row="1" Margin="0,0,0,15">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="15" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="15" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <Border Grid.Column="0" Background="#3498DB" CornerRadius="8" Padding="15">
                            <StackPanel>
                                <TextBlock Text="TOPLAM SATILAN ADET" Foreground="#D6EAF8" FontSize="13" FontWeight="Bold"/>
                                <TextBlock x:Name="txtRaporToplamAdet" Text="0 Adet" Foreground="White" FontSize="26" FontWeight="Bold"/>
                            </StackPanel>
                        </Border>

                        <Border Grid.Column="2" Background="#2ECC71" CornerRadius="8" Padding="15">
                            <StackPanel>
                                <TextBlock Text="TOPLAM CİRO" Foreground="#D5F5E3" FontSize="13" FontWeight="Bold"/>
                                <TextBlock x:Name="txtRaporToplamCiro" Text="0.00 ₺" Foreground="White" FontSize="26" FontWeight="Bold"/>
                            </StackPanel>
                        </Border>

                        <Border Grid.Column="4" Background="#16A085" CornerRadius="8" Padding="15">
                            <StackPanel>
                                <TextBlock Text="TAHMİNİ NET KAR" Foreground="#A3E4D7" FontSize="13" FontWeight="Bold"/>
                                <TextBlock x:Name="txtRaporToplamKar" Text="0.00 ₺" Foreground="White" FontSize="26" FontWeight="Bold"/>
                            </StackPanel>
                        </Border>
                    </Grid>

                    <!-- DataGrid -->
                    <DataGrid x:Name="dgUrunRaporu" Grid.Row="2" AutoGenerateColumns="False" IsReadOnly="True" 
                              Background="White" RowHeight="36" ColumnHeaderHeight="40" FontSize="15" 
                              GridLinesVisibility="Horizontal" HorizontalGridLinesBrush="#ECF0F1">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Barkod" Binding="{Binding Barkod}" Width="150" />
                            <DataGridTextColumn Header="Ürün Adı" Binding="{Binding UrunAdi}" Width="*" />
                            <DataGridTextColumn Header="Satılan Adet" Binding="{Binding SatilanAdet, StringFormat={}{0:N2}}" Width="120" />
                            <DataGridTextColumn Header="Toplam Ciro" Binding="{Binding ToplamCiro, StringFormat={}{0:N2} ₺}" Width="150" />
                            <DataGridTextColumn Header="Tahmini Kar" Binding="{Binding ToplamKar, StringFormat={}{0:N2} ₺}" Width="150" />
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </TabItem>

            <!-- TAB 2: FİŞ BULMA & İADE İŞLEMLERİ -->
            <TabItem Header="🔍 Fiş Bulma &amp; İade İşlemleri" FontSize="16" FontWeight="Bold" Padding="15,8">
                <Grid Margin="0,15,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="400" />
                        <ColumnDefinition Width="15" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <!-- Sol Panel: Fiş Arama & Detay -->
                    <Border Grid.Column="0" Background="White" CornerRadius="8" Padding="15" BorderBrush="#BDC3C7" BorderThickness="1">
                        <StackPanel Orientation="Vertical">
                            <TextBlock Text="Fiş Sorgulama" FontSize="18" FontWeight="Bold" Foreground="#2C3E50" Margin="0,0,0,15"/>

                            <TextBlock Text="Fiş Numarası (Örn: FIS260812...):" FontWeight="Bold" Margin="0,0,0,5"/>
                            <TextBox x:Name="txtFisNoArama" FontSize="16" Padding="8" BorderBrush="#BDC3C7" BorderThickness="1" Margin="0,0,0,10"/>
                            
                            <Button Content="🔍 Fişi Bul ve Getir" Background="#34495E" Foreground="White" FontSize="15" FontWeight="Bold" Padding="0,10" BorderThickness="0" Margin="0,0,0,20" Click="BtnFisAra_Click"/>

                            <!-- Fiş Özet Bilgileri -->
                            <Border Background="#F8F9F9" CornerRadius="6" Padding="12" Margin="0,0,0,15">
                                <StackPanel>
                                    <TextBlock Text="Fiş Detay Bilgileri" FontWeight="Bold" Foreground="#7F8C8D" Margin="0,0,0,8"/>
                                    <TextBlock x:Name="lblFisNo" Text="Fiş No: -" FontSize="15" FontWeight="Bold" Margin="0,2"/>
                                    <TextBlock x:Name="lblFisTarih" Text="Tarih: -" FontSize="14" Margin="0,2"/>
                                    <TextBlock x:Name="lblFisOdemeTuru" Text="Ödeme Türü: -" FontSize="14" Margin="0,2"/>
                                    <TextBlock x:Name="lblFisToplamTutar" Text="Toplam Tutar: 0.00 ₺" FontSize="18" FontWeight="Bold" Foreground="#27AE60" Margin="0,5"/>
                                    <TextBlock x:Name="lblFisDurum" Text="Durum: -" FontSize="14" FontWeight="Bold" Foreground="#2980B9" Margin="0,2"/>
                                </StackPanel>
                            </Border>

                            <!-- Eylem Butonları -->
                            <Button x:Name="btnFisYazdir" Content="🖨️ Fişi Tekrar Yazdır" Background="#2980B9" Foreground="White" FontSize="15" FontWeight="Bold" Padding="0,10" BorderThickness="0" Margin="0,0,0,10" IsEnabled="False" Click="BtnFisYazdir_Click"/>
                            <Button x:Name="btnFisIade" Content="↩️ Satış İadesi Al (İptal Et)" Background="#C0392B" Foreground="White" FontSize="15" FontWeight="Bold" Padding="0,10" BorderThickness="0" IsEnabled="False" Click="BtnFisIade_Click"/>
                        </StackPanel>
                    </Border>

                    <!-- Sağ Panel: Fiş İçeriği DataGrid -->
                    <Border Grid.Column="2" Background="White" CornerRadius="8" Padding="15" BorderBrush="#BDC3C7" BorderThickness="1">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>

                            <TextBlock Grid.Row="0" Text="Fişteki Ürünler Listesi" FontSize="18" FontWeight="Bold" Foreground="#2C3E50" Margin="0,0,0,10"/>

                            <DataGrid x:Name="dgFisDetay" Grid.Row="1" AutoGenerateColumns="False" IsReadOnly="True" 
                                      Background="White" RowHeight="36" ColumnHeaderHeight="40" FontSize="15" 
                                      GridLinesVisibility="Horizontal" HorizontalGridLinesBrush="#ECF0F1">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Ürün Adı" Binding="{Binding UrunAdi}" Width="*" />
                                    <DataGridTextColumn Header="Adet" Binding="{Binding Adet, StringFormat={}{0:N2}}" Width="100" />
                                    <DataGridTextColumn Header="Birim Fiyat" Binding="{Binding BirimFiyat, StringFormat={}{0:N2} ₺}" Width="130" />
                                    <DataGridTextColumn Header="Toplam Fiyat" Binding="{Binding ToplamFiyat, StringFormat={}{0:N2} ₺}" Width="150" />
                                </DataGrid.Columns>
                            </DataGrid>
                        </Grid>
                    </Border>
                </Grid>
            </TabItem>

        </TabControl>
    </Grid>
</Window>
