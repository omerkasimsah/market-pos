<Window x:Class="MarketPOS.Arayuzler.IadeIslemWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="↩ İade / Değişim İşlemi" Height="650" Width="750"
        WindowStartupLocation="CenterScreen" Background="#F4F6F9">

    <Grid Margin="15">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Başlık -->
        <Border Grid.Row="0" Background="#E74C3C" CornerRadius="8" Padding="12" Margin="0,0,0,10">
            <TextBlock Text="↩ İADE / DEĞİŞİM İŞLEMİ" FontSize="22" FontWeight="Black" Foreground="White" HorizontalAlignment="Center"/>
        </Border>

        <!-- Arama -->
        <Border Grid.Row="1" Background="White" CornerRadius="8" Padding="12" Margin="0,0,0,10" BorderBrush="#E0E0E0" BorderThickness="1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="Satış No / Fiş No:" FontWeight="Bold" FontSize="15" VerticalAlignment="Center" Margin="0,0,10,0"/>
                <TextBox x:Name="txtAramaSatisNo" Grid.Column="1" FontSize="16" Padding="8" Margin="0,0,10,0" KeyDown="TxtAramaSatisNo_KeyDown"/>
                <Button Grid.Column="2" Content="🔍 ARA" Background="#3498DB" Foreground="White" FontWeight="Bold" FontSize="14" Padding="15,6" BorderThickness="0" Click="BtnAra_Click">
                    <Button.Resources><Style TargetType="{x:Type Border}"><Setter Property="CornerRadius" Value="4"/></Style></Button.Resources>
                </Button>
            </Grid>
        </Border>

        <!-- Bulunan Satışın Ürünleri -->
        <DataGrid Grid.Row="2" x:Name="dgIadeUrunleri" AutoGenerateColumns="False" CanUserAddRows="False" IsReadOnly="False"
                  HeadersVisibility="Column" GridLinesVisibility="Horizontal" HorizontalGridLinesBrush="#E0E0E0"
                  RowHeight="40" FontSize="14" AlternatingRowBackground="#F7F9F9" Margin="0,0,0,10">
            <DataGrid.Columns>
                <DataGridCheckBoxColumn Header="✓" Binding="{Binding IadeSecildi}" Width="40"/>
                <DataGridTextColumn Header="Ürün Adı" Binding="{Binding UrunAdi}" Width="*" IsReadOnly="True"/>
                <DataGridTextColumn Header="Adet" Binding="{Binding Adet}" Width="70" IsReadOnly="True"/>
                <DataGridTextColumn Header="B. Fiyat" Binding="{Binding BirimFiyat, StringFormat={}{0:N2} ₺}" Width="90" IsReadOnly="True"/>
                <DataGridTextColumn Header="Önceki İade" Binding="{Binding OncekiIade, StringFormat=0.###}" Width="90" IsReadOnly="True"/>
                <DataGridTextColumn Header="İade Edilebilir" Binding="{Binding Kalan, StringFormat=0.###}" Width="100" IsReadOnly="True"/>
                <DataGridTextColumn Header="İade Adet" Binding="{Binding IadeAdedi, UpdateSourceTrigger=PropertyChanged}" Width="80"/>
            </DataGrid.Columns>
        </DataGrid>

        <!-- İade Sebebi ve Tutar -->
        <Border Grid.Row="3" Background="White" CornerRadius="8" Padding="12" Margin="0,0,0,10" BorderBrush="#E0E0E0" BorderThickness="1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Margin="0,0,10,0">
                    <TextBlock Text="İade Sebebi:" FontWeight="Bold" FontSize="13" Margin="0,0,0,3"/>
                    <ComboBox x:Name="cmbIadeSebebi" FontSize="14" Padding="5">
                        <ComboBoxItem Content="Bozuk / Hasarlı Ürün" IsSelected="True"/>
                        <ComboBoxItem Content="Yanlış Ürün Verildi"/>
                        <ComboBoxItem Content="Müşteri İstemedi"/>
                        <ComboBoxItem Content="SKT Geçmiş"/>
                        <ComboBoxItem Content="Diğer"/>
                    </ComboBox>
                </StackPanel>

                <StackPanel Grid.Column="1" Margin="10,0">
                    <TextBlock Text="İade Yöntemi:" FontWeight="Bold" FontSize="13" Margin="0,0,0,3"/>
                    <ComboBox x:Name="cmbIadeTuru" FontSize="14" Padding="5">
                        <ComboBoxItem Content="Nakit İade" IsSelected="True"/>
                        <ComboBoxItem Content="Veresiye Bakiyeye İade"/>
                    </ComboBox>
                </StackPanel>

                <Border Grid.Column="2" Background="#E74C3C" CornerRadius="8" Padding="15,10" VerticalAlignment="Center">
                    <StackPanel HorizontalAlignment="Center">
                        <TextBlock Text="İADE TUTARI" FontSize="12" Foreground="#FADBD8" FontWeight="Bold" HorizontalAlignment="Center"/>
                        <TextBlock x:Name="txtIadeTutari" Text="0.00 ₺" FontSize="24" FontWeight="Black" Foreground="White" HorizontalAlignment="Center"/>
                    </StackPanel>
                </Border>
            </Grid>
        </Border>

        <!-- Alt Butonlar -->
        <Grid Grid.Row="4">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="10"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Button Grid.Column="0" Content="✅ İADEYİ ONAYLA" Background="#E74C3C" Foreground="White" FontSize="18" FontWeight="Bold" Padding="0,12" BorderThickness="0" Click="BtnIadeOnayla_Click">
                <Button.Resources><Style TargetType="{x:Type Border}"><Setter Property="CornerRadius" Value="6"/></Style></Button.Resources>
            </Button>
            <Button Grid.Column="2" Content="❌ İPTAL" Background="#95A5A6" Foreground="White" FontSize="18" FontWeight="Bold" Padding="0,12" BorderThickness="0" Click="BtnIptal_Click" IsCancel="True">
                <Button.Resources><Style TargetType="{x:Type Border}"><Setter Property="CornerRadius" Value="6"/></Style></Button.Resources>
            </Button>
        </Grid>
    </Grid>
</Window>
