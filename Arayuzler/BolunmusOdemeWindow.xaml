<Window x:Class="MarketPOS.Arayuzler.BolunmusOdemeWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="💰 Bölünmüş Ödeme (Nakit + Kart + Veresiye)" Height="580" Width="650"
        WindowStartupLocation="CenterScreen" ResizeMode="NoResize" Background="#F4F6F9">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Başlık -->
        <StackPanel Grid.Row="0" Margin="0,0,0,15">
            <TextBlock Text="💰 BÖLÜNMÜŞ ÖDEME" FontSize="24" FontWeight="Black" Foreground="#2C3E50" HorizontalAlignment="Center"/>
            <TextBlock Text="Tutarı nakit, kart ve veresiye olarak bölebilirsiniz" FontSize="13" Foreground="#7F8C8D" HorizontalAlignment="Center"/>
        </StackPanel>

        <!-- Toplam Tutar Göstergesi -->
        <Border Grid.Row="1" Background="#2C3E50" CornerRadius="8" Padding="15" Margin="0,0,0,15">
            <Grid>
                <TextBlock Text="TOPLAM TUTAR:" FontSize="16" FontWeight="Bold" Foreground="#BDC3C7" HorizontalAlignment="Left" VerticalAlignment="Center"/>
                <TextBlock x:Name="txtToplamTutar" Text="0.00 ₺" FontSize="32" FontWeight="Black" Foreground="#F1C40F" HorizontalAlignment="Right" VerticalAlignment="Center"/>
            </Grid>
        </Border>

        <!-- Ödeme Bölmeleri -->
        <StackPanel Grid.Row="2">
            <!-- NAKİT -->
            <Border Background="#E8F8F5" CornerRadius="8" Padding="15" Margin="0,0,0,10" BorderBrush="#27AE60" BorderThickness="2">
                <StackPanel>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="💵 NAKİT:" FontSize="18" FontWeight="Bold" Foreground="#27AE60" VerticalAlignment="Center" Width="130"/>
                        <TextBox x:Name="txtNakitTutar" Grid.Column="1" FontSize="22" FontWeight="Bold" Padding="8" Text="0" TextChanged="OdemeTutarlari_Changed" HorizontalContentAlignment="Right" Margin="10,0"/>
                        <Button Grid.Column="2" Content="TÜMÜ" Background="#27AE60" Foreground="White" FontWeight="Bold" FontSize="13" Padding="12,6" BorderThickness="0" Click="BtnTumuNakit_Click" VerticalAlignment="Center">
                            <Button.Resources><Style TargetType="{x:Type Border}"><Setter Property="CornerRadius" Value="4"/></Style></Button.Resources>
                        </Button>
                    </Grid>
                    
                    <!-- Hızlı Nakit Butonları -->
                    <UniformGrid Columns="4" Margin="140,10,80,0" Height="40">
                        <Button Content="50 ₺" Background="#1ABC9C" Foreground="White" FontWeight="Bold" FontSize="16" Margin="2" BorderThickness="0" Click="HizliNakit_Click" Tag="50">
                            <Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="4"/></Style></Button.Resources>
                        </Button>
                        <Button Content="100 ₺" Background="#16A085" Foreground="White" FontWeight="Bold" FontSize="16" Margin="2" BorderThickness="0" Click="HizliNakit_Click" Tag="100">
                            <Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="4"/></Style></Button.Resources>
                        </Button>
                        <Button Content="200 ₺" Background="#27AE60" Foreground="White" FontWeight="Bold" FontSize="16" Margin="2" BorderThickness="0" Click="HizliNakit_Click" Tag="200">
                            <Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="4"/></Style></Button.Resources>
                        </Button>
                        <Button Content="TEMİZLE" Background="#E74C3C" Foreground="White" FontWeight="Bold" FontSize="14" Margin="2" BorderThickness="0" Click="HizliNakit_Click" Tag="0">
                            <Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="4"/></Style></Button.Resources>
                        </Button>
                    </UniformGrid>
                </StackPanel>
            </Border>

            <!-- KREDİ KARTI -->
            <Border Background="#EBF5FB" CornerRadius="8" Padding="15" Margin="0,0,0,10" BorderBrush="#2980B9" BorderThickness="2">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="💳 KART:" FontSize="18" FontWeight="Bold" Foreground="#2980B9" VerticalAlignment="Center" Width="130"/>
                    <TextBox x:Name="txtKartTutar" Grid.Column="1" FontSize="22" FontWeight="Bold" Padding="8" Text="0" TextChanged="OdemeTutarlari_Changed" HorizontalContentAlignment="Right" Margin="10,0"/>
                    <Button Grid.Column="2" Content="TÜMÜ" Background="#2980B9" Foreground="White" FontWeight="Bold" FontSize="13" Padding="12,6" BorderThickness="0" Click="BtnTumuKart_Click" VerticalAlignment="Center">
                        <Button.Resources><Style TargetType="{x:Type Border}"><Setter Property="CornerRadius" Value="4"/></Style></Button.Resources>
                    </Button>
                </Grid>
            </Border>

            <!-- VERESİYE -->
            <Border Background="#F5EEF8" CornerRadius="8" Padding="15" Margin="0,0,0,10" BorderBrush="#8E44AD" BorderThickness="2">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="📒 VERESİYE:" FontSize="18" FontWeight="Bold" Foreground="#8E44AD" VerticalAlignment="Center" Width="130"/>
                    <TextBox x:Name="txtVeresiyeTutar" Grid.Column="1" FontSize="22" FontWeight="Bold" Padding="8" Text="0" TextChanged="OdemeTutarlari_Changed" HorizontalContentAlignment="Right" Margin="10,0"/>
                    <Button Grid.Column="2" Content="MÜŞTERİ SEÇ" Background="#8E44AD" Foreground="White" FontWeight="Bold" FontSize="13" Padding="12,6" BorderThickness="0" Click="BtnMusteriSec_Click" VerticalAlignment="Center">
                        <Button.Resources><Style TargetType="{x:Type Border}"><Setter Property="CornerRadius" Value="4"/></Style></Button.Resources>
                    </Button>
                </Grid>
            </Border>

            <!-- Müşteri Bilgisi -->
            <TextBlock x:Name="txtSecilenMusteri" Text="" FontSize="14" FontWeight="Bold" Foreground="#8E44AD" HorizontalAlignment="Right" Margin="0,0,0,5"/>

            <!-- Kalan Tutar -->
            <Border Background="#FDEDEC" CornerRadius="8" Padding="12" Margin="0,5,0,0" BorderBrush="#E74C3C" BorderThickness="1">
                <Grid>
                    <TextBlock Text="KALAN TUTAR:" FontSize="16" FontWeight="Bold" Foreground="#C0392B" HorizontalAlignment="Left" VerticalAlignment="Center"/>
                    <TextBlock x:Name="txtKalanTutar" Text="0.00 ₺" FontSize="24" FontWeight="Black" Foreground="#E74C3C" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                </Grid>
            </Border>
        </StackPanel>

        <!-- Alt Butonlar -->
        <Grid Grid.Row="3" Margin="0,15,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="10"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Button Grid.Column="0" Content="✅ ÖDEMEYİ ONAYLA" Background="#27AE60" Foreground="White" FontSize="18" FontWeight="Bold" Padding="0,14" BorderThickness="0" Click="BtnOnayla_Click" x:Name="btnOnayla" IsEnabled="False">
                <Button.Resources><Style TargetType="{x:Type Border}"><Setter Property="CornerRadius" Value="6"/></Style></Button.Resources>
            </Button>

            <Button Grid.Column="2" Content="❌ İPTAL (ESC)" Background="#95A5A6" Foreground="White" FontSize="18" FontWeight="Bold" Padding="0,14" BorderThickness="0" Click="BtnIptal_Click" IsCancel="True">
                <Button.Resources><Style TargetType="{x:Type Border}"><Setter Property="CornerRadius" Value="6"/></Style></Button.Resources>
            </Button>
        </Grid>
    </Grid>
</Window>
