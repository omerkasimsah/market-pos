<Window x:Class="MarketPOS.Arayuzler.UyarilarWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Akıllı Bildirim Merkezi - SüperMarket POS" Height="768" Width="1024" WindowState="Maximized"
        Background="#F4F6F9" FontFamily="Segoe UI" FontSize="16"
        Loaded="Window_Loaded">

    <Grid Margin="15">
        <Grid.RowDefinitions>
            <RowDefinition Height="60" />
            <RowDefinition Height="50" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0" Background="#C0392B" CornerRadius="8" Padding="15,10" Margin="0,0,0,10">
            <Grid>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="🚨 AKILLI BİLDİRİM MERKEZİ &amp; SİSTEM RİSKLERİ" Foreground="White" FontSize="20" FontWeight="Bold"/>
                </StackPanel>

                <Button Content="Pencereyi Kapat" Background="#34495E" Foreground="White" FontWeight="Bold" HorizontalAlignment="Right" Padding="12,5" BorderThickness="0" Click="BtnKapat_Click">
                    <Button.Resources>
                        <Style TargetType="{x:Type Border}">
                            <Setter Property="CornerRadius" Value="4"/>
                        </Style>
                    </Button.Resources>
                </Button>
            </Grid>
        </Border>

        <!-- Kategori Filtre Butonları -->
        <StackPanel Grid.Row="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,0,10">
            <Button Content="Tüm Uyarım ve Riskler" Background="#34495E" Foreground="White" Padding="15,8" Margin="0,0,8,0" FontWeight="Bold" BorderThickness="0" Click="BtnFiltreTumu_Click"/>
            <Button Content="⏳ SKT Tarihi Yaklaşanlar" Background="#D35400" Foreground="White" Padding="15,8" Margin="0,0,8,0" FontWeight="Bold" BorderThickness="0" Click="BtnFiltreSkt_Click"/>
            <Button Content="📦 Kritik ve Eksi Stoklar" Background="#E74C3C" Foreground="White" Padding="15,8" Margin="0,0,8,0" FontWeight="Bold" BorderThickness="0" Click="BtnFiltreStok_Click"/>
            <Button Content="👥 Gecikmiş Veresiyeler" Background="#8E44AD" Foreground="White" Padding="15,8" Margin="0,0,8,0" FontWeight="Bold" BorderThickness="0" Click="BtnFiltreVeresiye_Click"/>
        </StackPanel>

        <!-- Uyarı Kartları Liste Alanı -->
        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
            <ItemsControl x:Name="lstUyarilar">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Background="White" CornerRadius="8" Padding="15" Margin="0,0,0,12" BorderThickness="2">
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Setter Property="BorderBrush" Value="#E74C3C"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding YuksekRisk}" Value="False">
                                            <Setter Property="BorderBrush" Value="#E67E22"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>

                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <!-- Sol Taraf: Kategori, Başlık ve Açıklama -->
                                <StackPanel Grid.Column="0">
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,5">
                                        <Border CornerRadius="4" Padding="8,3" Margin="0,0,10,0">
                                            <Border.Style>
                                                <Style TargetType="Border">
                                                    <Setter Property="Background" Value="#E74C3C"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding Kategori}" Value="SKT">
                                                            <Setter Property="Background" Value="#D35400"/>
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding Kategori}" Value="STOK">
                                                            <Setter Property="Background" Value="#C0392B"/>
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding Kategori}" Value="VERESİYE">
                                                            <Setter Property="Background" Value="#8E44AD"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>
                                            <TextBlock Text="{Binding Kategori}" Foreground="White" FontSize="12" FontWeight="Bold"/>
                                        </Border>

                                        <TextBlock Text="{Binding Baslik}" FontSize="18" FontWeight="Bold" Foreground="#2C3E50"/>
                                    </StackPanel>

                                    <TextBlock Text="{Binding Aciklama}" FontSize="15" Foreground="#34495E" TextWrapping="Wrap" Margin="0,2,0,0"/>
                                </StackPanel>

                                <!-- Sağ Taraf: Hızlı Eylem Butonu -->
                                <Button Grid.Column="1" Content="{Binding EylemMetni}" Background="#2980B9" Foreground="White" FontWeight="Bold" FontSize="14" Padding="15,10" BorderThickness="0" VerticalAlignment="Center" Tag="{Binding}" Click="BtnEylem_Click">
                                    <Button.Resources>
                                        <Style TargetType="{x:Type Border}">
                                            <Setter Property="CornerRadius" Value="6"/>
                                        </Style>
                                    </Button.Resources>
                                </Button>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>

    </Grid>
</Window>
