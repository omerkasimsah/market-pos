<Window x:Class="MarketPOS.Arayuzler.SiparisOlusturWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Kritik Stok Sipariş Listesi Oluştur" Height="500" Width="700"
        WindowStartupLocation="CenterOwner" ResizeMode="CanResizeWithGrip" Background="#F4F6F9">

    <Grid Margin="15">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="📦 Kritik Stoktaki Ürünler Sipariş Listesi" FontSize="20" FontWeight="Bold" Foreground="#34495E" Margin="0,0,0,15"/>

        <DataGrid Grid.Row="1" x:Name="dgSiparisler" AutoGenerateColumns="False" CanUserAddRows="False" IsReadOnly="True"
                  HeadersVisibility="Column" GridLinesVisibility="Horizontal" HorizontalGridLinesBrush="#E0E0E0"
                  RowHeight="35" FontSize="15" Background="White" BorderThickness="1" BorderBrush="#E0E0E0">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Barkod" Binding="{Binding Barkod}" Width="140" />
                <DataGridTextColumn Header="Ürün Adı" Binding="{Binding UrunAdi}" Width="*" />
                <DataGridTextColumn Header="Firma / Tedarikçi" Binding="{Binding Firma}" Width="150" />
                <DataGridTextColumn Header="Mevcut Stok" Binding="{Binding StokMiktari, StringFormat={}{0:N2}}" Width="120">
                    <DataGridTextColumn.ElementStyle>
                        <Style TargetType="TextBlock">
                            <Setter Property="HorizontalAlignment" Value="Center" />
                            <Setter Property="FontWeight" Value="Bold" />
                            <Setter Property="Foreground" Value="#C0392B" />
                        </Style>
                    </DataGridTextColumn.ElementStyle>
                </DataGridTextColumn>
            </DataGrid.Columns>
        </DataGrid>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,15,0,0">
            <Button Content="🖨 Sipariş Listesini Yazdır" Background="#3498DB" Foreground="White" FontWeight="Bold" FontSize="15" Padding="15,10" BorderThickness="0" Margin="0,0,10,0" Click="BtnYazdir_Click" />
            <Button Content="Kapat (ESC)" Background="#7F8C8D" Foreground="White" FontWeight="Bold" FontSize="15" Padding="15,10" BorderThickness="0" Click="BtnKapat_Click" IsCancel="True" />
        </StackPanel>
    </Grid>
</Window>
